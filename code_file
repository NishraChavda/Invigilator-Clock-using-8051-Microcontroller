ORG 00H
 LJMP MAIN
 ORG 30H
  MAIN:
 MOV DPTR , #MYDATA
 START:
 MOV R0,#00H
 MOV R1,#00H
 MOV R2,#00H
 MOV R3,#00H
 MOV R4,#00H
 MOV R5,#00H
 
 CJNE R7 ,#0D , DISPLAY
 MOV R0,#9
 MOV R1,#5
 MOV R2,#9
 MOV R3,#5
 MOV R4,#2
 MOV R5,#0
 MOV R7,#00H
 
 DISPLAY:
 INC R7
 ACALL SHOW
 BACK:
 DEC R0
 CJNE R0, #00H,DISPLAY
 MOV R0, #10
 DEC R1
 CJNE R1, #00H ,DISPLAY
 MOV R1, #5
 DEC R2
 CJNE R2,#00H,DISPLAY
 MOV R2,#10
 DEC R3
 CJNE R3,#00H,DISPLAY
 MOV R3,#5
 MOV A,R5
 XRL A, #2D
 JZ HOUR1
 JNZ XX
 XX:
 DEC R4
 CJNE R4,#00H,DISPLAY
 MOV R4,#10
 SJMP HOUR2
 HOUR1:
 DEC R4
 CJNE R4,#00H,DISPLAY
 MOV R4 ,#4
 MOV R5,#02D
 
 HOUR2:
 DEC R5
 CJNE R5,#3D,DISPLAY
 SJMP START
 
 SHOW:
 MOV R6,#82D
 REPEAT:
 MOV A,R0
 MOVC A,@A+DPTR
 SETB P2.0
 MOV P1,A
 ACALL DELAY
 CLR P2.0
 MOV A,R1
 MOVC A,@A+DPTR
 SETB P2.1
 MOV P1,A
 ACALL DELAY
 CLR P2.1
 MOV A,R2
 MOVC A,@A+DPTR
 SETB P2.2
 MOV P1,A
 ACALL DELAY
 CLR P2.2
 MOV A,R3
 MOVC A,@A+DPTR
 SETB P2.3
 MOV P1 ,A
 ACALL DELAY
 CLR P2.3
 MOV A,R4
 MOVC A,@A+DPTR
 SETB P2.4
 MOV P1,A
 ACALL DELAY
 CLR P2.4
 MOV A,R5
 MOVC A,@A+DPTR
 SETB P2.5
 MOV P1,A
 ACALL DELAY
 CLR P2.5
 DJNZ R6, REPEAT
 RET
 
 DELAY:
 SETB PSW. 4
 MOV R2,#10
 AGAIN2: MOV R3 ,#100
 AGAIN1:DJNZ R3,AGAIN1
 DJNZ R2 , AGAIN2
 CLR PSW. 4
 RET
 
 ORG 300H
  MYDATA:
  DB 3FH,06H,5BH,4FH,66H,6DH,7DH,07H,7FH,6FH
   END
